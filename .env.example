# PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/workena?schema=public"

# Auth.js — generate a random secret with: openssl rand -base64 32
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Optional: reject Google identities not hosted on this Workspace domain.
GOOGLE_WORKSPACE_DOMAIN=""

# S3-compatible object storage (AWS S3, MinIO, or another compatible service)
S3_REGION="eu-central-1"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_ENDPOINT=""
# Set true for providers such as MinIO. Leave unset for AWS S3.
S3_FORCE_PATH_STYLE="false"
# Maximum allowed image size in bytes (default 8 MiB).
UPLOAD_MAX_BYTES="8388608"
