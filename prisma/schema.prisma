generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  MANAGER
  EMPLOYEE
}

enum EntryStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id              String       @id @default(cuid())
  name            String?
  email           String       @unique
  emailVerified   DateTime?
  image           String?
  accounts        Account[]
  sessions        Session[]
  membership      Membership?
  authoredEntries WorkEntry[]  @relation("EntryAuthor")
  reviewedEntries WorkEntry[]  @relation("EntryReviewer")
  createdInvites  Invitation[] @relation("InviteCreator")
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}

model Company {
  id                 String       @id @default(cuid())
  name               String
  emailDomain        String?
  enforceEmailDomain Boolean      @default(false)
  memberships        Membership[]
  invitations        Invitation[]
  entries            WorkEntry[]
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
}

model Membership {
  id        String   @id @default(cuid())
  companyId String
  userId    String   @unique
  role      Role     @default(EMPLOYEE)
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([companyId, userId])
  @@index([companyId, role])
}

model Invitation {
  id          String    @id @default(cuid())
  companyId   String
  email       String
  role        Role      @default(EMPLOYEE)
  tokenHash   String    @unique
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdById String
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy   User      @relation("InviteCreator", fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@index([companyId, email])
  @@index([expiresAt])
}

model WorkEntry {
  id           String       @id @default(cuid())
  companyId    String
  userId       String
  workedAt     DateTime
  hours        Decimal      @db.Decimal(5, 2)
  workType     String
  workplace    String
  note         String?
  status       EntryStatus  @default(PENDING)
  reviewedAt   DateTime?
  reviewedById String?
  reviewNote      String?
  company         Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  author       User         @relation("EntryAuthor", fields: [userId], references: [id], onDelete: Cascade)
  reviewer     User?        @relation("EntryReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  attachments  Attachment[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@unique([id, companyId])
  @@index([companyId, workedAt])
  @@index([companyId, userId, workedAt])
  @@index([companyId, workplace, workType])
  @@index([companyId, status])
}

model Attachment {
  id        String    @id @default(cuid())
  companyId String
  entryId   String
  objectKey String    @unique
  fileName  String
  mimeType  String
  sizeBytes Int
  entry     WorkEntry @relation(fields: [entryId, companyId], references: [id, companyId], onDelete: Cascade)
  createdAt DateTime  @default(now())

  @@index([companyId, entryId])
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@id([identifier, token])
}
