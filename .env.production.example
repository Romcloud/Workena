# Set these as encrypted environment variables in the hosting platform.
# Never deploy this example file with real credentials.
DATABASE_URL="postgresql://USER:PASSWORD@DB_HOST:5432/workena?schema=public&sslmode=require"

# Generate with: openssl rand -base64 32
AUTH_SECRET=""
AUTH_URL="https://workena.eu"
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Optional Google Workspace restriction, e.g. firma.sk
GOOGLE_WORKSPACE_DOMAIN=""

S3_REGION="eu-central-1"
S3_BUCKET=""
# For AWS, prefer the host's IAM/workload role and leave both keys unset.
# For other S3-compatible providers, configure both access key variables.
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Leave empty for AWS S3; set for another S3-compatible service.
S3_ENDPOINT=""
S3_FORCE_PATH_STYLE="false"
UPLOAD_MAX_BYTES="8388608"
